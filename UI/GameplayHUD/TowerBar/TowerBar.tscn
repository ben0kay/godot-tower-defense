[gd_scene format=3]

[node name="TowerBar" type="PanelContainer"]
mouse_filter = 0

[node name="Insets" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="Tray" type="VBoxContainer" parent="Insets"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Insets/Tray"]
layout_mode = 2

[node name="Title" type="Label" parent="Insets/Tray/Header"]
layout_mode = 2
text = "BUILD TOWERS"
theme_override_font_sizes/font_size = 14

[node name="Spacer" type="Control" parent="Insets/Tray/Header"]
layout_mode = 2
mouse_filter = 2
size_flags_horizontal = 3

[node name="Hint" type="Label" parent="Insets/Tray/Header"]
layout_mode = 2
text = "CTRL TO CLOSE"
theme_override_font_sizes/font_size = 11

[node name="CategoryScroll" type="ScrollContainer" parent="Insets/Tray"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
horizontal_scroll_mode = 1
vertical_scroll_mode = 0

[node name="Categories" type="HBoxContainer" parent="Insets/Tray/CategoryScroll"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Scroll" type="ScrollContainer" parent="Insets/Tray"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 1
vertical_scroll_mode = 0
follow_focus = true

[node name="Buttons" type="GridContainer" parent="Insets/Tray/Scroll"]
layout_mode = 2
theme_override_constants/h_separation = 7
theme_override_constants/v_separation = 7
columns = 1
