[ext_resource type="Script" uid="uid://wp8k6saxg34f" path="res://LEVELS/Briefing/MissionBriefingDefinition.cs" id="1"]

[resource]
script = ExtResource("1")
Title = "DEFEND THE CITADEL"
Message = "Commander, welcome to the field.

Today's assignment is a little unconventional. We've recovered several hostile drones and successfully reprogrammed them for target practice.

Your objective is simple: deploy a few Battle Towers and put their combat capabilities to the test.

I'll be monitoring their performance and keeping an eye on you.

Let's see what these towers can do, Commander. Good luck."
Objectives = "• Protect the Citadel.
• Build a defensive line along the approach.
• Press START WAVE when you are ready."
