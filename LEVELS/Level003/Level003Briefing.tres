[ext_resource type="Script" path="res://LEVELS/Briefing/MissionBriefingDefinition.cs" id="1"]

[resource]
script = ExtResource("1")
Title = "LAVA FIELDS"
Message = "Commander, Lava has flooded this sector. Enemy ships can cross it, but they'll take damage along the way. Use your Foundation Platforms to redirect their paths over the lava, weakening them before they reach our Citadel. Let the terrain do some of the work for us."
Objectives = "• Guide enemies across lava using Foundation Platforms.\n• Use environmental damage to soften approaching ships.\n• Protect the Citadel."
VoiceCueId = "voice_mission_level003_intro"
