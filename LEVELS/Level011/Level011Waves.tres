[gd_resource type="Resource" script_class="WaveSetResource" format=3]

[ext_resource type="Script" path="res://LEVELS/Waves/Resources/WaveBatchResource.cs" id="batch"]
[ext_resource type="Script" path="res://LEVELS/Waves/Resources/WaveEnemyResource.cs" id="enemy"]
[ext_resource type="Script" path="res://LEVELS/Waves/Resources/WaveResource.cs" id="wave"]
[ext_resource type="Script" path="res://LEVELS/Waves/Resources/WaveSetResource.cs" id="set"]

[sub_resource type="Resource" id="basic"]
script = ExtResource("enemy")
EnemyId = "basic_mk1"

[sub_resource type="Resource" id="batch1"]
script = ExtResource("batch")
Count = 10
Interval = 0.85
Enemies = Array[ExtResource("enemy")]([SubResource("basic")])

[sub_resource type="Resource" id="wave1"]
script = ExtResource("wave")
Number = 1
Batches = Array[ExtResource("batch")]([SubResource("batch1")])

[resource]
script = ExtResource("set")
Waves = Array[ExtResource("wave")]([SubResource("wave1")])
